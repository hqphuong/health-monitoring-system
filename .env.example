# Node Environment
NODE_ENV=production
PORT=3000

# Database Configuration (Neon PostgreSQL Cloud)
DATABASE_URL="postgresql://neondb_owner:your_neon_password@your_neon_host/neondb?sslmode=require"

# JWT Configuration
JWT_SECRET="HealthGuard_Secret_Key_2026"

# Email Configuration (Gmail SMTP)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Redis Configuration (Optional - used for BullMQ job queue)
REDIS_URL=redis://redis:6379
